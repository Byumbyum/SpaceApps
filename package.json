{
  "name": "dalton-ground-motion-observatory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:generate": "python demo/generate_demo.py",
    "data:gcov": "node --env-file-if-exists=../.env --env-file-if-exists=.env --max-old-space-size=4096 scripts/process-gcov.mjs",
    "data:gcov:local": "node --max-old-space-size=4096 scripts/process-gcov.mjs --source=local",
    "data:sites": "node scripts/lib/site-index.mjs",
    "data:gunw": "node --env-file-if-exists=../.env --env-file-if-exists=.env --max-old-space-size=4096 scripts/process-gunw.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "html-to-image": "^1.11.13",
    "maplibre-gl": "^6.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.1.1",
    "geotiff": "^2.1.3",
    "jsdom": "^27.2.0",
    "pngjs": "^7.0.0",
    "rollup": "npm:@rollup/wasm-node@4.68.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  },
  "overrides": {
    "rollup": "$rollup"
  }
}
